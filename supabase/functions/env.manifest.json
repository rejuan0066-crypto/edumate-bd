{
  "$schema": "./README.md",
  "_comment": "Required environment variables per edge function. Used by scripts/check-edge-function-env.sh as a pre-deploy gate. 'required' must exist in the deploy environment; 'optional' is informational. 'example' values are safe placeholders shown when a var is missing locally — they MUST NOT be used in production. The 'always' block lists vars Supabase injects automatically into every function.",
  "always": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_ANON_KEY",
      "SUPABASE_SERVICE_ROLE_KEY"
    ],
    "examples": {
      "SUPABASE_URL": "https://<project-ref>.supabase.co",
      "SUPABASE_ANON_KEY": "eyJhbGciOi...<anon>",
      "SUPABASE_SERVICE_ROLE_KEY": "eyJhbGciOi...<service-role>"
    }
  },
  "functions": {
    "send-otp": {
      "required": ["RESEND_API_KEY"],
      "examples": { "RESEND_API_KEY": "re_xxxxxxxxxxxxxxxxxxxxxxxx" }
    },
    "send-welcome-email": {
      "required": ["RESEND_API_KEY"],
      "examples": { "RESEND_API_KEY": "re_xxxxxxxxxxxxxxxxxxxxxxxx" }
    },
    "send-donation-receipt": {
      "required": ["RESEND_API_KEY"],
      "examples": { "RESEND_API_KEY": "re_xxxxxxxxxxxxxxxxxxxxxxxx" }
    },
    "test-email-template": {
      "required": ["RESEND_API_KEY"],
      "examples": { "RESEND_API_KEY": "re_xxxxxxxxxxxxxxxxxxxxxxxx" }
    },
    "send-sms": {
      "optional": ["SMS_API_KEY", "SMS_SENDER_ID"],
      "examples": {
        "SMS_API_KEY": "your-sms-provider-api-key",
        "SMS_SENDER_ID": "8809XXXXXXX"
      }
    },
    "send-whatsapp": {
      "optional": ["WHATSAPP_API_KEY", "WHATSAPP_PHONE_ID"],
      "examples": {
        "WHATSAPP_API_KEY": "EAAG...",
        "WHATSAPP_PHONE_ID": "1234567890"
      }
    },
    "send-push": {
      "required": ["VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY", "VAPID_SUBJECT"],
      "examples": {
        "VAPID_PUBLIC_KEY": "BPxxxxxxxxxxxxxxxxxxxx",
        "VAPID_PRIVATE_KEY": "xxxxxxxxxxxxxxxxxxxxxxxx",
        "VAPID_SUBJECT": "mailto:admin@example.com"
      }
    },
    "process-payment": {
      "optional": ["SSLCOMMERZ_STORE_ID", "SSLCOMMERZ_STORE_PASSWORD", "SSLCOMMERZ_SANDBOX"],
      "examples": {
        "SSLCOMMERZ_STORE_ID": "yourstore",
        "SSLCOMMERZ_STORE_PASSWORD": "yourpassword",
        "SSLCOMMERZ_SANDBOX": "true"
      }
    },
    "verify-card": {
      "optional": ["CARD_VERIFY_API_KEY"],
      "examples": { "CARD_VERIFY_API_KEY": "your-card-verify-key" }
    },
    "design-ai": {
      "required": ["LOVABLE_API_KEY"],
      "examples": { "LOVABLE_API_KEY": "lov_xxxxxxxxxxxxxxxxx" }
    },
    "generate-questions": {
      "required": ["LOVABLE_API_KEY"],
      "examples": { "LOVABLE_API_KEY": "lov_xxxxxxxxxxxxxxxxx" }
    },
    "scan-questions": {
      "required": ["LOVABLE_API_KEY"],
      "examples": { "LOVABLE_API_KEY": "lov_xxxxxxxxxxxxxxxxx" }
    },
    "remove-bg": {
      "required": ["LOVABLE_API_KEY"],
      "examples": { "LOVABLE_API_KEY": "lov_xxxxxxxxxxxxxxxxx" }
    },
    "test-smtp": {
      "optional": ["SMTP_HOST", "SMTP_PORT", "SMTP_USER", "SMTP_PASSWORD"],
      "examples": {
        "SMTP_HOST": "smtp.example.com",
        "SMTP_PORT": "587",
        "SMTP_USER": "noreply@example.com",
        "SMTP_PASSWORD": "your-smtp-password"
      }
    }
  }
}
